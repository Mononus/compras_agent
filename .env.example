# Prefijo para los comandos (default: !)
BOT_PREFIX=!

# JID del grupo objetivo. Dejalo vacío la primera vez:
# el bot va a imprimir en consola el JID cuando alguien escriba en el grupo.
# Después copialo acá, ej: 120363012345678901@g.us
TARGET_GROUP=

# (Opcional) Habilita lenguaje natural con la API de Claude.
# Si lo dejás vacío, el bot igual funciona solo con comandos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ruta del archivo de datos (default: ./lista.json)
DATA_FILE=./lista.json
