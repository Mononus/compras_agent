# Prefijo para los comandos (default: !)
BOT_PREFIX=!

# JID del grupo objetivo. Dejalo vacío la primera vez:
# el bot va a imprimir en consola el JID cuando alguien escriba en el grupo.
# Después copialo acá, ej: 120363012345678901@g.us
TARGET_GROUP=

# (Opcional) Habilita lenguaje natural con la API de Claude.
# Si lo dejás vacío, el bot igual funciona solo con comandos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ruta del archivo de datos (default: ./lista.json)
DATA_FILE=./lista.json

# ---------------------------------------------------------------------------
# Gastos mensuales (módulo gastos/). Vacío = módulo apagado.
# ---------------------------------------------------------------------------

# JID del grupo donde se manejan los gastos. Para averiguarlo:
# LISTAR_GRUPOS=true y mirar el log al conectar.
TARGET_GROUP_GASTOS=

# Datos y comprobantes (rutas relativas al directorio del bot)
GASTOS_FILE=./gastos.json
COMPROBANTES_DIR=./comprobantes
MAX_COMPROBANTE_MB=20

# Cuándo corre la revisión diaria de vencimientos
CRON_GASTOS=0 9 * * *
TZ_GASTOS=America/Argentina/Buenos_Aires

# Días de aviso previo por defecto (cada gasto puede tener el suyo)
AVISO_DIAS=3
# Vencido y sin pagar: insistir cada N días, hasta M veces (después, semanal)
INSISTIR_CADA=2
MAX_INSISTENCIAS=3

# RECORDATORIOS_GASTOS=off apaga solo los avisos automáticos (los comandos siguen)
# RESUMEN_MENSUAL=on manda el listado del mes el día 1
# CRON_GASTOS_MENSUAL=0 9 1 * *
